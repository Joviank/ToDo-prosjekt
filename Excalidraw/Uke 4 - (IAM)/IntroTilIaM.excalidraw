    },
    {
      "id": "p7tTN-2MF93nbORW6ValP",
      "type": "text",
      "x": 66.69808343704028,
      "y": 1110.9728518901154,
      "width": 472.4197082519531,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2X",
      "roundness": null,
      "seed": 1529257789,
      "version": 174,
      "versionNonce": 1011388755,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779349256281,
      "link": null,
      "locked": false,
      "text": "JWT (Json web token) = Førekort\nEt digitalt ID-kort som sendes mellom systemer.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "JWT (Json web token) = Førekort\nEt digitalt ID-kort som sendes mellom systemer.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "UKSXjHntlj764SPn1uJLh",
      "type": "text",
      "x": 68.78160591994481,
      "y": 1193.2244688194926,
      "width": 386.4597473144531,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2Y",
      "roundness": null,
      "seed": 1135063069,
      "version": 372,
      "versionNonce": 779153139,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779349256281,
      "link": null,
      "locked": false,
      "text": "Sertifikat (SSL- eller TLS) = Pass\nDigital bevis på at en utsteder er ekte.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sertifikat (SSL- eller TLS) = Pass\nDigital bevis på at en utsteder er ekte.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "xugQDHMR-EFPnj8DDeDr6",
      "type": "text",
      "x": 744.7647087488695,
      "y": 1088.7874904946148,
      "width": 628.2197265625,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2a",
      "roundness": null,
      "seed": 1571641811,
      "version": 269,
      "versionNonce": 128060979,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779349256281,
      "link": null,
      "locked": false,
      "text": "Førerkortet beviser bare at du har lov til å gjøre noe (kjøre bil).\nDet gjør deg ikke automatisk til en godkjent statsborger på\ntvers av landegrenser.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Førerkortet beviser bare at du har lov til å gjøre noe (kjøre bil).\nDet gjør deg ikke automatisk til en godkjent statsborger på\ntvers av landegrenser.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "msnl35I9ERdv8nd1kYM-l",
      "type": "text",
      "x": 747.4953043912872,
      "y": 1180.297273902898,
      "width": 478.11962890625,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2b",
      "roundness": null,
      "seed": 2101226301,
      "version": 413,
      "versionNonce": 1330106323,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779349256281,
      "link": null,
      "locked": false,
      "text": "Passet beviser selve identiteten din og at du er \ngodkjent av en øverste myndighet.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Passet beviser selve identiteten din og at du er \ngodkjent av en øverste myndighet.",
      "autoResize": true,
      "lineHeight": 1.25
    },
