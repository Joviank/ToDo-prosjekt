      "index": "b4D",
      "roundness": null,
      "seed": 15488794,
      "version": 150,
      "versionNonce": 2017466502,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779785958909,
      "link": null,
      "locked": false,
