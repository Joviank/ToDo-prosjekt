      "boundElements": [],
      "updated": 1779784376903,
      "link": null,
      "locked": false,
      "text": "Bevis på at tokenet ikke er manipulert.\n\nDet er denne som beviser at informasjonen \ni payload ikke har blitt endret undervise \nav en hacker.\n\nDet fungerer som det offisielle \nstempelet på passet ditt.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Bevis på at tokenet ikke er manipulert.\n\nDet er denne som beviser at informasjonen \ni payload ikke har blitt endret undervise \nav en hacker.\n\nDet fungerer som det offisielle \nstempelet på passet ditt.",
      "autoResize": true,
      "lineHeight": 1.25
    },
