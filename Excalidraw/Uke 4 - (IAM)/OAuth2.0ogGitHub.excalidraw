      "boundElements": [],
      "updated": 1779784376903,
      "link": null,
      "locked": false,
      "text": "Authentication Provider (IdP) (brukt litt løst)\nTjenesten som gir deg tilgang basert på identitet.\n(Kan kombineres med IdP i praksis)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Authentication Provider (IdP) (brukt litt løst)\nTjenesten som gir deg tilgang basert på identitet.\n(Kan kombineres med IdP i praksis)",
