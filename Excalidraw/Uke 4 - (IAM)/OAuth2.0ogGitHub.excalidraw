      "link": null,
      "locked": false,
      "text": "Consent = \"Vil du gi applikasjonen tilgang?\"\nHva er risikoen i å gi en applikasjon for mye tilgang?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Consent = \"Vil du gi applikasjonen tilgang?\"\nHva er risikoen i å gi en applikasjon for mye tilgang?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "l9D4bLrRu1CwT0El15OpV",
      "type": "text",
      "x": 929.1609306994611,
      "y": 1411.6931264592706,
      "width": 401.6708567851133,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4C",
      "roundness": null,
      "seed": 1781728710,
      "version": 135,
      "versionNonce": 1422537030,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779785958909,
      "link": null,
      "locked": false,
      "text": "hvis du gir den appen for mye tilgang så\nkan den gjøre ting som du ikke vil på\nkontoen din.\n\nsom sende meldinger som deg osv.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "hvis du gir den appen for mye tilgang så kan den gjøre ting som du ikke vil på kontoen din.\n\nsom sende meldinger som deg osv.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "-qkdi76P2jrJzsL_zbAwQ",
