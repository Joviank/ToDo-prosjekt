      "isDeleted": true,
      "boundElements": [],
      "updated": 1778568873591,
      "link": null,
      "locked": false,
      "text": "Hvis du ikke får kontakt = APIen krasje",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Hvis du ikke får kontakt = APIen krasje",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "u06xkU5KnbOxL21oCtiDV",
      "type": "text",
      "x": 348.9687295725082,
      "y": 1197.8734900429627,
      "width": 778.87939453125,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
