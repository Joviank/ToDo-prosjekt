      "version": 194,
      "versionNonce": 1432482123,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1778568873591,
      "link": null,
      "locked": false,
      "text": "Testene våre beskytter \"telefonnummeret\", men ikke hva som skjer inni personen:\nTDD og API kontrakter",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
